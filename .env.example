# Copy to .env and adjust. Never commit real keys.
APP_ENV=dev
API_KEYS=dev-key
# LLM: auto | groq | ollama | openai_compatible | none
LLM_PROVIDER=auto
GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=http://host.docker.internal:11434/v1   # for Ollama
DATABASE_URL=postgresql+psycopg://rca:rca@postgres:5432/rca
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rca-password
MAX_ITERATIONS=3
ESCALATION_DELAY_DAYS=10
